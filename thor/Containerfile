# hadolint global ignore=DL3008,DL3059,DL4006
# DL4006: podman builds OCI images, which ignore SHELL, so RUN keeps /bin/sh.

ARG UBUNTU_IMAGE=docker.io/library/ubuntu:24.04@sha256:a853f94d226358a79c740cfc7bce0c289748f3fe3488d921d038ccd752c61b60
ARG RUST_IMAGE=docker.io/library/rust:1.98-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e


FROM ${UBUNTU_IMAGE} AS system-files

COPY system_files/ /system_files/
RUN chmod -R go-w /system_files


FROM ${UBUNTU_IMAGE} AS bootc-builder

ENV PATH=/usr/lib/rust-1.91/bin:$PATH

ARG BOOTC_VERSION=v1.17.1
ARG OSTREE_VERSION=v2026.1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y \
    autoconf \
    automake \
    bison \
    build-essential \
    ca-certificates \
    cargo-1.91 \
    git \
    go-md2man \
    gtk-doc-tools \
    libcurl4-openssl-dev \
    libext2fs-dev \
    libfuse3-dev \
    libglib2.0-dev \
    libgpgme-dev \
    liblzma-dev \
    libsoup-3.0-dev \
    libssl-dev \
    libsystemd-dev \
    libtool \
    libzstd-dev \
    meson \
    pkg-config

# bootc requires ostree >= 2025.3 but Ubuntu 24.04 ships 2024.5, so build from source.
WORKDIR /ostree
RUN git clone \
    --depth 1 \
    --branch ${OSTREE_VERSION} \
    --recurse-submodules \
    --shallow-submodules \
    --jobs 8 \
    https://github.com/ostreedev/ostree.git . && \
    env NOCONFIGURE=1 ./autogen.sh && \
    ./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --sysconfdir=/etc \
    --with-curl \
    --with-libsystemd && \
    make -j"$(nproc)" && \
    make install && \
    make install-libLTLIBRARIES install-binPROGRAMS DESTDIR=/out && \
    ldconfig

WORKDIR /bootc
RUN git clone --depth 1 --branch "${BOOTC_VERSION}" https://github.com/bootc-dev/bootc.git .

# The rhel9 feature selects composefs-rs loopback EROFS mounts, which work on
# the Jetson's 6.8 kernel (file-backed EROFS needs Linux 6.12+). Ubuntu does not
# use SELinux, so leave out the default selinux feature.
RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/bootc/target,sharing=locked \
    make bin install DESTDIR=/out \
    CARGO_OPTIONS='--no-default-features --features "install-to-disk rhel9"'


FROM ${RUST_IMAGE} AS bootc-imagectl

ARG BOOTC_IMAGECTL_REV=a0a0868428a08e1463a9627b65eed334e9f2c2e3
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo install --locked --root /out \
    --git https://github.com/yeetypete/bootc-imagectl --rev "${BOOTC_IMAGECTL_REV}" \
    bootc-imagectl


FROM ${UBUNTU_IMAGE} AS image

ENV DEBIAN_FRONTEND=noninteractive

# Keep package installs from generating an initramfs. finalize builds it with dracut.
ENV INITRD=No

# Create every user and group with the UID and GID the sysusers lock file fixes
# before any package can allocate a different one.
COPY --from=system-files /system_files/usr/lib/sysusers.d/ /usr/lib/sysusers.d/
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y systemd && \
    systemd-sysusers

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y \
    ca-certificates \
    curl \
    gpg

# NVIDIA Jetson repos for JetPack 7.2 (Jetson Linux r39.2). 'som' serves the
# Jetson modules (Orin and Thor share this suite), 'common' carries CUDA,
# TensorRT, and friends.
RUN curl -fsSLo /tmp/nvidia-jetson.asc "https://repo.download.nvidia.com/jetson/jetson-ota-public.asc" && \
    gpg --dearmor -o /usr/share/keyrings/nvidia-jetson.gpg /tmp/nvidia-jetson.asc && \
    rm /tmp/nvidia-jetson.asc
COPY --from=system-files /system_files/etc/apt/sources.list.d/ /etc/apt/sources.list.d/

# Stub update-initramfs (NVIDIA packages expect it, but we use dracut), and skip
# the L4T preinst QSPI boot-firmware flash, which assumes a live install.
RUN printf '#!/bin/sh\nexit 0\n' > /usr/sbin/update-initramfs && \
    chmod +x /usr/sbin/update-initramfs && \
    mkdir -p /opt/nvidia/l4t-packages && \
    touch /opt/nvidia/l4t-packages/.nv-l4t-disable-boot-fw-update-in-preinstall

ARG KERNEL_RELEASE=6.8.0-1035-nvidia-tegra
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y \
    avahi-daemon \
    bubblewrap \
    dosfstools \
    dracut \
    e2fsprogs \
    efibootmgr \
    fdisk \
    less \
    libnss-mdns \
    libnss-systemd \
    linux-image-${KERNEL_RELEASE} \
    linux-modules-extra-${KERNEL_RELEASE} \
    linux-modules-tegra-igpu-openrm-jetson-${KERNEL_RELEASE} \
    linux-modules-tegra-oot-jetson-${KERNEL_RELEASE} \
    nvidia-l4t-3d-core \
    nvidia-l4t-bootloader \
    nvidia-l4t-camera \
    nvidia-l4t-core \
    nvidia-l4t-cuda-openrm \
    nvidia-l4t-firmware \
    nvidia-l4t-firmware-openrm \
    nvidia-l4t-gbm \
    nvidia-l4t-gstreamer \
    nvidia-l4t-init \
    nvidia-l4t-multimedia \
    nvidia-l4t-multimedia-utils \
    nvidia-l4t-nvfancontrol \
    nvidia-l4t-nvml \
    nvidia-l4t-nvpmodel \
    nvidia-l4t-nvsci \
    nvidia-l4t-pva \
    nvidia-l4t-tools \
    openssh-server \
    podman \
    skopeo \
    systemd-boot \
    systemd-boot-efi \
    systemd-resolved \
    systemd-timesyncd \
    systemd-ukify \
    ubuntu-minimal \
    xfsprogs \
    zstd && \
    # Canonical's iGPU defaults blacklist the GPU modules and leave loading to
    # the nv-load-* services, which are masked below.
    rm -f /etc/modprobe.d/tegra-igpu-jetson-defaults_nvidia-display_nvidia-tegra.conf

# bootc links against the ostree built alongside it.
COPY --from=bootc-builder /out/usr/ /usr/
RUN ldconfig

COPY --from=system-files /system_files/ /

# Replicate the masked nv-load-gpu-libs.service, which writes to read-only /usr.
# Thor (tegra264) uses openrm.
RUN libdir=/opt/nvidia/l4t-gpu-libs/openrm && \
    ln -sfnT "$libdir/libcuda.so" /usr/lib/aarch64-linux-gnu/libcuda.so && \
    ln -sfnT "$libdir/libcuda.so.1" /usr/lib/aarch64-linux-gnu/libcuda.so.1 && \
    echo "$libdir" > /etc/ld.so.conf.d/000-nvidia-gpu-libs.conf && \
    ldconfig

# Ubuntu ships tmp.mount in /usr/share/systemd/ (opt-in). Copy it to the unit
# search path so systemctl enable can find it.
RUN cp /usr/share/systemd/tmp.mount /usr/lib/systemd/system/

RUN systemctl enable \
    avahi-daemon.service \
    nvidia-display-load.service \
    ssh.service \
    systemd-growfs@sysroot.service \
    systemd-networkd.service \
    systemd-resolved.service \
    systemd-timesyncd.service \
    tmp.mount && \
    systemctl disable \
    apt-daily-upgrade.timer \
    apt-daily.timer && \
    # nv-l4t-bootloader-config.service is not bootc-aware (runs lsblk on the
    # composefs root). On Thor it is safe to mask, since UEFI and nvbootctrl read
    # board identity from EEPROM directly.
    #
    # nvpmodel.service applies the default power mode (120W) at boot. On Thor any
    # mode change requires a reboot, which nvpmodel cannot persist on bootc's
    # read-only /opt, so the service fails. Mask it.
    rm -f \
    /etc/systemd/system/multi-user.target.wants/nv-l4t-bootloader-config.service \
    /etc/systemd/system/multi-user.target.wants/nv-load-display-modules.service \
    /etc/systemd/system/multi-user.target.wants/nvpmodel.service \
    /etc/systemd/system/sysinit.target.wants/nv-load-gpu-libs.service \
    /etc/systemd/system/nv-graphics.service \
    /etc/systemd/system/nv-l4t-bootloader-config.service \
    /etc/systemd/system/nv-load-display-modules.service \
    /etc/systemd/system/nv-load-gpu-libs.service \
    /etc/systemd/system/nvpmodel.service && \
    systemctl mask \
    nv-graphics.service \
    nv-l4t-bootloader-config.service \
    nv-load-display-modules.service \
    nv-load-gpu-libs.service \
    nvpmodel.service

# Create home directories on first login. Drop the pam_lastlog.so line, since the
# module is gone from Ubuntu 24.04 and fails to dlopen.
RUN pam-auth-update --enable mkhomedir && \
    sed -i '/pam_lastlog\.so/d' /etc/pam.d/login

# The base image's ubuntu user, with password ubuntu and passwordless sudo.
RUN echo 'ubuntu:ubuntu' | chpasswd && \
    echo "ubuntu ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu && \
    chmod 440 /etc/sudoers.d/ubuntu

LABEL containers.bootc=1
CMD ["/sbin/init"]


FROM image AS finalized

COPY --from=bootc-imagectl /out/bin/bootc-imagectl /usr/libexec/bootc-imagectl
RUN --network=none /usr/libexec/bootc-imagectl finalize \
    --sysusers-lock /usr/lib/sysusers.d/00-bootc-imagectl.lock.conf


# The UKI embeds the kernel and initramfs.
FROM finalized AS rootfs

RUN bootc container split-kernel-and-rootfs --output /kernel && \
    rm -r /kernel

RUN bootc container lint --fatal-warnings


# WORKAROUND: podman < 6.0 (buildah 1.44) leaves bind-mounted stages out of
# cache keys. Building on rootfs keeps a cached UKI from being reused with a
# different rootfs.
FROM rootfs AS uki

# The kernel and initramfs come from finalized, the systemd-stub from rootfs.
# The UKI carries no devicetree. The Jetson's UEFI firmware provides it.
RUN --mount=type=bind,from=rootfs,target=/target \
    --mount=type=bind,from=finalized,source=/usr/lib/modules,target=/kernel \
    kver="$(ls /kernel)" && \
    mkdir /uki && \
    bootc container ukify --rootfs /target --kernel-dir "/kernel/${kver}" \
    -- --stub /target/usr/lib/systemd/boot/efi/linuxaa64.efi.stub \
    --output "/uki/${kver}.efi"


FROM rootfs

COPY --from=uki /uki/ /boot/EFI/Linux/

ARG VERSION=v0.0.0
ARG REVISION=
LABEL org.opencontainers.image.source="https://github.com/yeetypete/bootc-jetson" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.revision="${REVISION}" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.title="bootc-jetson Thor" \
    org.opencontainers.image.description="bootc image for NVIDIA Jetson Thor on JetPack 7.2."
