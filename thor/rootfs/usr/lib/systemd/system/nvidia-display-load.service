# Load the openrm GPU/display stack (Thor / tegra264) once the platform is up.
# udev's modalias autoload probes too early and fails, so
# nvidia-defer-autoload.conf blacklists it. This replaces
# nv-load-display-modules.service, whose `depmod -a` writes to /usr which is
# read-only in bootc.
[Unit]
Description=Load NVIDIA openrm GPU/display modules after platform init
After=systemd-modules-load.service
Before=display-manager.service nvpmodel.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/modprobe nvidia_drm

[Install]
WantedBy=multi-user.target
